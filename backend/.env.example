// StellarPulse backend environment configuration
nodeEnv=NODE_ENV

# --- Server ---
PORT=4000
HOST=0.0.0.0

# --- Stellar Network ---
# testnet | mainnet | standalone
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org

# --- Contract addresses (after deployment) ---
PAYROLL_VAULT_CONTRACT=CDXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZK_VERIFIER_CONTRACT=CDXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
USDC_CONTRACT=CCXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Account that signs relayed payout transactions ---
# TCS -- a multi-sig guardian on testnet. NEVER store a live mainnet secret here.
RELAY_SECRET=SCXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RELAY_PUBLIC=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellarpulse
REDIS_URL=redis://localhost:6379

# --- API auth ---
# Comma-separated list of accepted API keys
API_KEYS=dev_public_key_do_not_use_in_prod
API_KEY_HEADER=x-api-key

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# --- ZK proving service ---
ZK_PROOF_DIR=../circuits
ZK_WASM=zkey-gen/solvency_js/solvency.wasm
ZK_ZKEY=solvency_final.zkey
ZK_VKEY=solvency_verification_key.json